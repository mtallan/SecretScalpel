  },
  {
    "id": "3P-ZIP-PASSWORD-LONG",
    "input": "zip -r --password ZipLongPass archive.zip /docs/",
    "expected": "zip -r --password *********** archive.zip /docs/"
  },
  {
    "id": "3P-RAR-PASSWORD-P",
    "input": "rar a -pRarFilePass archive.rar files/",
