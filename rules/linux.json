  {
    "id": "LNX-MYSQL-FAMILY-P-SEPARATED",
    "comment": "Matches all mysql/mariadb family tools (mysql, mysqladmin, mysqldump, mysqlimport, mysqlshow, mysqlslap and their mariadb-* equivalents) using space-separated -u user -p password form.",
    "phrase": [
      "(?i)\\b(?:mysql(?:admin|dump|import|show|slap)?|mariadb(?:-(?:admin|dump|import|show|slap))?)(?:\\.exe)?\\b.*?\\s-u\\s+\\S+\\s+-p\\s+([^-\\s]\\S*)"
    ],
    "isRegex": true,
    "required_byte": "-",
    "priority": 1,
    "enabled": true,
    "min_length": 4
  },
  {
    "id": "LNX-MYSQL-FAMILY-PASSWORD",
    "comment": "Matches all mysql/mariadb family tools using --password password form.",
    "phrase": [
