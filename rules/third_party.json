[
  {
    "id": "3P-PLINK-PW",
    "comment": "Matches PuTTY Link (plink) with a -pw flag. Uses the trie with a wildcard to handle variable arguments.",
    "phrase": [
      "<any:^plink(\\.exe)?$>",
      "<any>",
      "<any>",
      "-pw",
      "<REDACT>"
    ],
    "priority": 0,
    "enabled": true,
    "min_length": 4
  },
  {
    "id": "3P-CURL-U",
    "comment": "Matches curl basic auth credentials with -u flag.",
    "phrase": [
      "<any:^curl(\\.exe)?$>",
      "-u",
      "<redact:.*:.*>"
    ],
    "priority": 0,
    "enabled": true,
    "min_length": 3
  },
  {
    "id": "3P-CURL-USER",
    "comment": "Matches curl basic auth credentials with --user flag.",
    "phrase": [
      "<any:^curl(\\.exe)?$>",
      "--user",
      "<redact:.*:.*>"
    ],
    "priority": 0,
    "enabled": true,
    "min_length": 3
  },
  {
    "id": "3P-CURL-PROXY-U",
    "comment": "Matches curl proxy credentials with -U flag.",
    "phrase": [
      "<any:^curl(\\.exe)?$>",
      "-U",
      "<redact:.*:.*>"
    ],
    "priority": 0,
    "enabled": true,
    "min_length": 3
  },
  {
    "id": "3P-CURL-PROXY-USER",
    "comment": "Matches curl proxy credentials with --proxy-user flag.",
    "phrase": [
      "<any:^curl(\\.exe)?$>",
      "--proxy-user",
      "<redact:.*:.*>"
    ],
    "priority": 0,
    "enabled": true,
    "min_length": 3
  },
  {
    "id": "3P-CURL-PASS",
    "comment": "Matches curl private key passphrase: curl --pass MyPassphrase",
    "phrase": [
      "<any:^curl(\\.exe)?$>",
      "--pass",
      "<REDACT>"
    ],
    "priority": 0,
    "enabled": true,
    "min_length": 4
  },
  {
    "id": "3P-CURL-TLSPASSWORD",
    "comment": "Matches curl TLS password: curl --tlspassword MyTLSPass",
    "phrase": [
      "<any:^curl(\\.exe)?$>",
      "--tlspassword",
      "<REDACT>"
    ],
    "priority": 0,
    "enabled": true,
    "min_length": 4
  },
  {
    "id": "3P-GIT-AUTH",
    "comment": "Matches git clone URLs with embedded credentials. Regex is required here to redact a substring within a single token.",
    "phrase": [
      "(?i)git\\s+clone\\s+https?://(?:.+?):(.+)@"
    ],
    "isRegex": true,
    "required_byte": "@",
    "priority": 1,
    "enabled": true,
    "min_length": 5
  },
  {
    "id": "3P-SQLPLUS",
    "comment": "Matches Oracle SQL*Plus credentials: sqlplus username/password[@service]",
    "phrase": [
      "(?i)\\bsqlplus(?:\\.exe)?\\s+[^/\\s]+/([^@\\s]+)"
    ],
    "isRegex": true,
    "required_byte": "/",
    "priority": 1,
    "enabled": true,
    "min_length": 3
  },
  {
    "id": "3P-SVN-PASSWORD",
    "comment": "Matches svn with space-separated --password flag at any argument position.",
    "phrase": [
      "(?i)\\bsvn\\b.*?--password\\s+([^\\s'\\\"]+)"
    ],
    "isRegex": true,
    "required_byte": "-",
    "priority": 1,
    "enabled": true,
    "min_length": 4
  },
  {
    "id": "3P-SQSH",
    "comment": "Matches Sybase sqsh client: sqsh -U user -P password",
    "phrase": [
      "sqsh",
      "-U",
      "<any>",
      "-P",
      "<redact:^[^-].*>"
    ],
    "priority": 0,
    "enabled": true,
    "min_length": 4
  },
  {
    "id": "3P-ISQL",
    "comment": "Matches Sybase/MSSQL isql client: isql -U user -P password",
    "phrase": [
      "isql",
      "-U",
      "<any>",
      "-P",
      "<redact:^[^-].*>"
    ],
    "priority": 0,
    "enabled": true,
    "min_length": 4
  },
  {
    "id": "3P-VAULT-KV-PUT",
    "comment": "Matches HashiCorp Vault kv put with password=secret key-value pair.",
    "phrase": [
      "vault",
      "kv",
      "put",
      "<any>",
      "<redact:^password=.+>"
    ],
    "redact_after": "password=",
    "priority": 0,
    "enabled": true,
    "min_length": 4
  },
  {
    "id": "3P-VAULT-WRITE",
    "comment": "Matches HashiCorp Vault write with password=secret key-value pair.",
    "phrase": [
      "vault",
      "write",
      "<any>",
      "<redact:^password=.+>"
    ],
    "redact_after": "password=",
    "priority": 0,
    "enabled": true,
    "min_length": 4
  },
  {
    "id": "3P-SECRETSDUMP",
    "comment": "Matches impacket secretsdump NTLM hash lines: username:RID:LMhash:NTLMhash:::",
    "phrase": [
      "(?i)[^\\s:]+:[0-9]+:([0-9a-f]{32}:[0-9a-f]{32}):::"
    ],
    "isRegex": true,
    "required_byte": ":",
    "priority": 1,
    "enabled": true,
    "min_length": 32
  },
  {
    "id": "3P-ZIP-PASSWORD",
    "comment": "Matches zip/unzip -P password and --password password flags (space-separated plaintext password).",
    "phrase": [
      "(?i)\\b(?:un)?zip(?:\\.exe)?\\b.*?(?:-P|--password)\\s+([^\\s'\"]+)"
    ],
    "isRegex": true,
    "required_byte": "-",
    "priority": 1,
    "enabled": true,
    "min_length": 2
  },
  {
    "id": "3P-RAR-PASSWORD",
    "comment": "Matches rar/unrar -pPASSWORD and -hpPASSWORD flags (password attached directly to flag, no space).",
    "phrase": [
      "(?i)\\b(?:un)?rar(?:\\.exe)?\\b.*?-h?p([^\\s'\"\\-][^\\s'\"]*)"
    ],
    "isRegex": true,
    "required_byte": "-",
    "priority": 1,
    "enabled": true,
    "min_length": 2
  },
  {
    "id": "3P-NUGET-PASSWORD",
    "comment": "Matches nuget sources add/update -password <password>. Single-dash, space-separated flag not caught by PHASE0-GENERIC-FLAG-PASSWORD.",
    "phrase": [
      "(?i)\\bnuget(?:\\.exe)?\\b.*?\\s-password\\s+([^-\\s]\\S*)"
    ],
    "isRegex": true,
    "required_byte": "-",
    "priority": 1,
    "enabled": true,
    "min_length": 2
  }
]
